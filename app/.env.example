# TAGO(국가교통정보센터, apis.data.go.kr) 공공데이터포털에서 발급
# https://www.data.go.kr/data/15098894/openapi.do
TAGO_API_KEY_1=
TAGO_API_KEY_2=
TAGO_API_KEY_3=

# api/server.ts에서 실제 조회에 사용하는 서비스 키 (TAGO 발급 키와 동일 계열)
DATA_GO_KR_SERVICE_KEY=

# 서버 실행 설정 (api/server.ts)
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development
