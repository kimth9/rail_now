# 실제 .env는 OneDrive 동기화 폴더 밖 %LOCALAPPDATA%\rail_now\.env 에 둔다
# (2026-08-30, 과거 zip 압축 시 평문 유출 이력으로 프로젝트 폴더 밖으로 이전)

# 국토교통부_열차 시간표 조회 서비스 (1613000) — server.ts에서 사용
# https://www.data.go.kr/data/15098894/openapi.do
MOLIT_TAGO_KEY=

# 한국철도공사_열차운행정보 서비스 (B551457) — scripts/fetch_station_data.py에서 사용
KORAIL_KEY=

# 서버 실행 설정 (api/server.ts)
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development
